# Copy this file to ".env" (gitignored) and paste your Dataverse API key.
# The web app and API read the key from here -- the browser never asks for it.

DATAVERSE_TOKEN=paste-your-api-key-here    # <-- YOUR DATAVERSE API KEY GOES HERE
DATAVERSE_URL=https://134.95.195.250       # Dataverse server (optional; default shown)
DATAVERSE_ROOT=                            # root collection to list in the picker (optional)
DATAVERSE_INSECURE=true                    # self-signed cert -> skip TLS verify (default true)
